<Window x:Class="M365.EndpointInspector.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:M365.EndpointInspector.Wpf"
        Title="{Binding WindowTitle}" Language="pl-PL"
        Icon="Assets/AppIcon.ico"
        FontFamily="Inter, Segoe UI" FontSize="13" Width="1320" Height="860"
        MinWidth="940" MinHeight="620" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="InvalidFilterTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="Invalid">
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderBrush" Value="#9B251C"/>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Invalid"/>
                        <Condition Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InvalidFilterComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="Invalid">
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InvalidFilterComboBoxBorder" TargetType="Border">
            <Style.Triggers>
                <Trigger Property="Tag" Value="Invalid">
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="BorderBrush" Value="#9B251C"/>
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterWarningBanner" TargetType="Border">
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#9B251C"/>
            <Setter Property="Background" Value="#FFF0EE"/>
            <Setter Property="TextElement.Foreground" Value="#9B251C"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=FilterProblem}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9B251C"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,0,4"/>
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="{StaticResource Ink}" Padding="18,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Requirements browser" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Label}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel x:Name="SourceActions" DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="_Download from Internet" Click="Download_Click"/>
                    <Button Content="_Open file" Click="OpenFile_Click" Margin="8,0,0,0"/>
                    <Button Content="Reachabili_ty…" Click="Reachability_Click" Margin="8,0,0,0"/>
                    <Button Content="_Export CSV…" Click="ExportCsv_Click" Margin="8,0,0,0"/>
                    <Menu VerticalAlignment="Center" Margin="12,0,0,0">
                        <MenuItem Header="_More">
                            <MenuItem Header="Local data…" Click="LocalData_Click"/>
                            <MenuItem Header="Synthetic example (Synthetic)" Click="OpenDemo_Click"/>
                            <MenuItem Header="Open local cache…" Click="OpenCache_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" x:Name="SourcePanel" Padding="18,9"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Rule}">
            <StackPanel>
                <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource SectionHeading}"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="{Binding Metadata}" TextWrapping="Wrap" Margin="0,2,0,0" MaxHeight="64"
                           ToolTip="{Binding Metadata}"/>
                <ScrollViewer MaxHeight="44" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <TextBlock Text="{Binding Notice, TargetNullValue=''}" Style="{StaticResource OptionalText}"
                               ToolTip="{Binding Notice}"/>
                </ScrollViewer>
                <Expander Header="Read details" Visibility="{Binding HasDetails, Converter={StaticResource VisibleIfTrue}}">
                    <ScrollViewer MaxHeight="78" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" x:Name="SaveNotice" Margin="12,0"
                   Style="{StaticResource OptionalText}" AutomationProperties.LiveSetting="Polite"/>
        <Border DockPanel.Dock="Bottom" x:Name="ActivityPanel" Visibility="Collapsed"
                Padding="12,5" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Rule}">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="CancelAction" Content="_Cancel operation" Click="Cancel_Click"/>
                <StackPanel>
                    <ScrollViewer MaxHeight="58" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <TextBlock x:Name="Activity" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </ScrollViewer>
                    <Expander x:Name="ActivityDetails" Header="Read details" Visibility="Collapsed">
                        <ScrollViewer MaxHeight="78" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ActivityDetailText" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Expander>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderThickness="0,0,1,0" BorderBrush="{StaticResource Rule}">
                <DockPanel x:Name="FilterPanel" Margin="14,10">
                    <TextBlock DockPanel.Dock="Top" Text="Filters" Style="{StaticResource SectionHeading}"/>
                    <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="0,8,0,0">
                        <Button Content="_Apply" Click="Apply_Click" FontWeight="SemiBold"/>
                        <Button Content="_Reset" Click="Reset_Click" Margin="6,0,0,0"/>
                    </UniformGrid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,4">
                            <Label Content="Service _area" Target="{Binding ElementName=Area}"/>
                            <ComboBox x:Name="Area"/>
                            <Label Content="_Category" Target="{Binding ElementName=CategoryBox}"/>
                            <ComboBox x:Name="CategoryBox"/>
                            <Label Content="Required" Target="{Binding ElementName=RequiredBox}"/>
                            <ComboBox x:Name="RequiredBox"/>
                            <Label Content="Protocol" Target="{Binding ElementName=Protocol}"/>
                            <Border x:Name="ProtocolValidationBorder" Style="{StaticResource InvalidFilterComboBoxBorder}"
                                    Tag="{Binding Tag, ElementName=Protocol}">
                                <ComboBox x:Name="Protocol" Style="{StaticResource InvalidFilterComboBox}"/>
                            </Border>
                            <TextBlock x:Name="ProtocolError" Text="" Style="{StaticResource FieldErrorText}"/>
                            <Label Content="_Port or range" Target="{Binding ElementName=Ports}"/>
                            <TextBox MaxLength="16384" x:Name="Ports" Style="{StaticResource InvalidFilterTextBox}" ToolTip="Port, range or list, e.g. 443, 5000-5004. Select TCP or UDP."/>
                            <TextBlock x:Name="PortsError" Text="" Style="{StaticResource FieldErrorText}"/>
                            <Label Content="_Domain or entry pattern" Target="{Binding ElementName=DomainBox}"/>
                            <TextBox MaxLength="16384" x:Name="DomainBox" Style="{StaticResource InvalidFilterTextBox}" ToolTip="Concrete DNS name or exact pattern from the open snapshot."/>
                            <TextBlock x:Name="DomainBoxError" Text="" Style="{StaticResource FieldErrorText}"/>
                            <Label Content="_IP address or CIDR" Target="{Binding ElementName=Address}"/>
                            <TextBox MaxLength="16384" x:Name="Address" Style="{StaticResource InvalidFilterTextBox}" ToolTip="IPv4, IPv6 or network prefix, e.g. 192.0.2.32/27"/>
                            <TextBlock x:Name="AddressError" Text="" Style="{StaticResource FieldErrorText}"/>
                            <Expander x:Name="SourceFields" Header="Source fields" Margin="0,12,0,0">
                                <StackPanel Margin="6,3,0,0">
                                    <Label Content="Service name (exact)" Target="{Binding ElementName=DisplayNameBox}"/>
                                    <TextBox MaxLength="16384" x:Name="DisplayNameBox"/>
                                    <Label Content="Notes (exact)" Target="{Binding ElementName=Notes}"/>
                                    <TextBox MaxLength="16384" x:Name="Notes"/>
                                    <Label Content="JSON Pointer path" Target="{Binding ElementName=Pointer}"/>
                                    <TextBox MaxLength="16384" x:Name="Pointer" Style="{StaticResource InvalidFilterTextBox}" ToolTip="E.g. /extra/routing/0/tag"/>
                                    <TextBlock x:Name="PointerError" Text="" Style="{StaticResource FieldErrorText}"/>
                                    <Label Content="JSON value" Target="{Binding ElementName=JsonValue}"/>
                                    <TextBox MaxLength="16384" x:Name="JsonValue" Style="{StaticResource InvalidFilterTextBox}" ToolTip="E.g. &quot;blue&quot;, true or null. An empty field with a specified path means the property is missing."/>
                                    <TextBlock x:Name="JsonValueError" Text="" Style="{StaticResource FieldErrorText}"/>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="Comparison" Header="Entry comparison" Margin="0,10,0,0">
                                <StackPanel Margin="6,4,0,0">
                                    <Button Content="Synthetic reference…" Click="OpenReference_Click"/>
                                    <TextBlock x:Name="ReferenceInfo" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <Label Content="Entry change" Target="{Binding ElementName=Change}"/>
                                    <Border x:Name="ChangeValidationBorder" Style="{StaticResource InvalidFilterComboBoxBorder}"
                                            Tag="{Binding Tag, ElementName=Change}">
                                        <ComboBox x:Name="Change" Style="{StaticResource InvalidFilterComboBox}"/>
                                    </Border>
                                    <TextBlock x:Name="ChangeError" Text="" Style="{StaticResource FieldErrorText}"/>
                                    <Button x:Name="DetachReference" Content="Detach reference"
                                            Click="Detach_Click" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" x:Name="ResultsPanel" Margin="14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="52"/>
                    <RowDefinition Height="7"/>
                    <RowDefinition Height="0.65*" MinHeight="94"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource SectionHeading}"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Border x:Name="FilterProblemBanner" Style="{StaticResource FilterWarningBanner}">
                        <StackPanel>
                            <TextBlock x:Name="FilterProblemHeading" Text="⚠ Filter error" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                            <TextBlock x:Name="FilterProblem" Text="" FontWeight="Bold" FontSize="15" Margin="0,4,0,0"
                                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ComparisonCaption" Style="{StaticResource OptionalText}"/>
                </StackPanel>
                <DockPanel Grid.Row="1">
                    <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding ShowCommon, Converter={StaticResource VisibleIfTrue}}">
                        <TextBlock Text="{Binding CommonHeading}" Margin="0,10,0,0" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Text="All current Common entries for the selected service." Margin="0,1,0,4"/>
                        <local:EndpointGrid x:Name="CommonGrid" MaxHeight="124"
                                            AutomationProperties.Name="Common dependencies" SelectionChanged="SelectRow"/>
                    </StackPanel>
                    <local:EndpointGrid x:Name="HitsGrid"
                                        AutomationProperties.Name="Filter hits" SelectionChanged="SelectRow"/>
                </DockPanel>
                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="{StaticResource Rule}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              AutomationProperties.Name="Details panel height"/>
                <DockPanel Grid.Row="3" x:Name="DetailPanel" Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeading}"
                               Text="{Binding Title, TargetNullValue='Entry details', FallbackValue='Entry details'}"/>
                    <DockPanel DockPanel.Dock="Top" x:Name="TargetBar" LastChildFill="False" Margin="0,3,0,4">
                        <Label Content="Entry target" Target="{Binding ElementName=Targets}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <ComboBox x:Name="Targets" Width="214"
                                  DisplayMemberPath="Value" SelectionChanged="SelectTarget"/>
                        <Button x:Name="Memberships" Content="Show all target IDs" Click="Memberships_Click"
                                ToolTip="Search for this domain or IP range across all service areas." Margin="6,0,0,0"/>
                    </DockPanel>
                    <TextBox Text="{Binding RawJson, Mode=OneWay, FallbackValue='Select a row to read JSON details.'}"
                             IsReadOnly="True" FontFamily="Consolas" FontSize="12" IsUndoEnabled="False"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{Binding RepresentationLabel, FallbackValue='Selected entry JSON details'}"/>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
