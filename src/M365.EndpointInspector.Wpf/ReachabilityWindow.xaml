<Window x:Class="M365.EndpointInspector.Wpf.ReachabilityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reachability diagnostics" Width="1050" Height="650" MinWidth="740" MinHeight="485" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <WrapPanel Margin="0,0,0,6">
                <Button x:Name="CancelButton" Content="_Cancel checks" Click="Cancel_Click" IsEnabled="False"/>
                <Button Content="Open Microsoft 365 connectivity _test" Click="OpenMicrosoftTest_Click" Margin="6,0,0,0"
                        ToolTip="Opens the official Microsoft test in your default browser. No targets or results are passed."/>
            </WrapPanel>
            <TextBlock TextWrapping="Wrap" Text="Checks local DNS, direct TCP on the target port (443 unless specified in the HTTPS URL), and HTTPS HEAD using the system proxy policy (which may bypass the proxy). These checks do not verify application health."/>
            <TextBlock x:Name="Status" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <Border x:Name="TargetWarning" Visibility="Collapsed" Margin="0,6,0,0" Padding="8,5"
                    BorderThickness="2" BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                           Text="Invalid target. Enter a host or IP without a port. To specify a port, use a full HTTPS URL, for example https://localhost:443/. Do not include credentials, a query or a fragment."/>
            </Border>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer MaxHeight="235" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Label Content="_Host, IP address or HTTPS URL (no credentials, query or fragment)" Target="{Binding ElementName=HostBox}"/>
                    <TextBox x:Name="HostBox"/>
                    <Expander Header="Targets from selected browser rows (Ctrl/Shift to select multiple)" Margin="0,6,0,0">
                        <ListBox x:Name="SelectedTargets" SelectionMode="Extended" MaxHeight="100"/>
                    </Expander>
                    <WrapPanel Margin="0,8">
                        <Button x:Name="RunButton" Content="_Run target" Click="Run_Click" Padding="8,3"/>
                        <Button x:Name="SelectedButton" Content="Run _selected targets" Click="Selected_Click" Margin="6,0"/>
                        <ComboBox x:Name="AreaBox" MinWidth="105" AutomationProperties.Name="Service area"/>
                        <Button x:Name="AreaButton" Content="Run entire _area" Click="Area_Click" Margin="6,0"/>
                    </WrapPanel>
                    <TextBlock x:Name="Preview" TextWrapping="Wrap"/>
                    <Expander Header="Skipped targets by scope">
                        <ListBox x:Name="SkippedTargets" MaxHeight="100"/>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <DockPanel Grid.Row="1" Margin="0,8,0,0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button x:Name="RetryButton" Content="_Retry failures" Click="Retry_Click" Margin="6,0"/>
                <Button x:Name="CopyButton" Content="Cop_y results" Click="Copy_Click"/>
                <TextBlock x:Name="ProgressSummary" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </WrapPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <Grid.Resources>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <TextBlock x:Name="StageActivity" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" MinHeight="21"/>
                                <ProgressBar x:Name="ActivityPulse" Height="4" Visibility="Hidden" AutomationProperties.Name="Stage activity"/>
                            </StackPanel>
                            <DataGrid x:Name="StageRows" AutomationProperties.Name="Stage progress" RowHeight="25"
                                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" ClipboardCopyMode="None">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Host and port" Binding="{Binding Authority}" Width="*"/>
                                    <DataGridTextColumn Header="Stage" Binding="{Binding StageLabel}" Width="145"/>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/>
                                    <DataGridTextColumn Header="Diagnostic" Binding="{Binding Diagnostic}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                    <DataGrid x:Name="Results" Grid.Row="1" AutomationProperties.Name="Attempt results" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" ClipboardCopyMode="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Attempt" Binding="{Binding Attempt}" Width="Auto"/>
                            <DataGridTextColumn Header="Host and port" Binding="{Binding Target.Authority}" Width="*"/>
                            <DataGridTextColumn Header="Stage" Binding="{Binding StageLabel}" Width="Auto"/>
                            <DataGridTextColumn Header="Outcome" Binding="{Binding Status}" Width="Auto"/>
                            <DataGridTextColumn Header="HTTPS route" Binding="{Binding RouteLabel}" Width="Auto"/>
                            <DataGridTextColumn Header="Elapsed" Binding="{Binding Timing}" Width="Auto"/>
                            <DataGridTextColumn Header="Diagnostic" Binding="{Binding Detail}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
